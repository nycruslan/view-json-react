{
  "name": "view-json-react",
  "version": "3.0.0-next.0",
  "packageManager": "pnpm@12.5.1",
  "description": "A lightweight, performant React component for visualizing JSON data with collapsible nodes, dark mode, and copy functionality",
  "type": "module",
  "main": "./dist/view-json-react.cjs",
  "module": "./dist/view-json-react.esm.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/view-json-react.esm.js",
    "./dist/view-json-react.cjs"
  ],
  "author": "Ruslan Shulga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nycruslan/view-json-react.git"
  },
  "homepage": "https://nycruslan.github.io/view-json-react/?path=/docs/components-jsonviewer--docs",
  "bugs": {
    "url": "https://github.com/nycruslan/view-json-react/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/view-json-react.esm.js",
      "require": "./dist/view-json-react.cjs",
      "default": "./dist/view-json-react.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.map",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nycruslan"
  },
  "scripts": {
    "build": "pnpm run clean && vite build && pnpm run size",
    "build-storybook": "storybook build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm run build",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "30.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "size-limit": "^13.0.3",
    "storybook": "^10.5.9",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "5.0.1"
  },
  "license": "MIT",
  "keywords": [
    "json",
    "react",
    "json viewer",
    "json visualizer",
    "react component",
    "data visualization",
    "collapsible json",
    "expandable json",
    "json tree view",
    "json explorer",
    "json parser",
    "interactive json",
    "development tool",
    "web development",
    "frontend",
    "UI component",
    "code visualization",
    "json formatter",
    "react library"
  ],
  "size-limit": [
    {
      "path": "dist/view-json-react.cjs",
      "limit": "20 KB"
    },
    {
      "path": "dist/view-json-react.esm.js",
      "limit": "20 KB"
    }
  ]
}
