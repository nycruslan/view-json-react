{
  "name": "view-json-react",
  "version": "3.0.0-next.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18"
  },
  "description": "A lightweight, accessible React tree for safely inspecting JSON and JavaScript values",
  "type": "module",
  "main": "./dist/view-json-react.cjs",
  "module": "./dist/view-json-react.esm.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "author": "Ruslan Shulga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nycruslan/view-json-react.git"
  },
  "homepage": "https://nycruslan.github.io/view-json-react/?path=/docs/components-jsonviewer--docs",
  "bugs": {
    "url": "https://github.com/nycruslan/view-json-react/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/view-json-react.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/view-json-react.cjs"
      },
      "default": "./dist/view-json-react.esm.js"
    },
    "./virtual": {
      "import": {
        "types": "./dist/virtual.d.ts",
        "default": "./dist/virtual.js"
      },
      "require": {
        "types": "./dist/virtual.d.cts",
        "default": "./dist/virtual.cjs"
      },
      "default": "./dist/virtual.js"
    },
    "./headless": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/headless.cjs"
      },
      "default": "./dist/headless.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nycruslan"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level low",
    "build": "node scripts/build.mjs && pnpm run size",
    "build-storybook": "storybook build",
    "benchmark": "pnpm run build && node --expose-gc scripts/benchmark.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build && pnpm run test:package",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . && knip",
    "lint:fix": "eslint . --fix",
    "lint:unused": "knip",
    "prepack": "pnpm run build",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/file": "^14.0.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "30.1.0",
    "knip": "6.37.0",
    "publint": "0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.0",
    "storybook": "^10.6.0",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "license": "MIT",
  "keywords": [
    "json",
    "react",
    "json viewer",
    "json visualizer",
    "react component",
    "data visualization",
    "collapsible json",
    "expandable json",
    "json tree view",
    "json explorer",
    "json inspector",
    "interactive json",
    "accessible",
    "aria tree",
    "virtualized",
    "development tool",
    "web development",
    "frontend",
    "UI component",
    "code visualization",
    "json formatter",
    "react library"
  ],
  "size-limit": [
    {
      "path": "dist/view-json-react.esm.js",
      "limit": "6.5 KB"
    },
    {
      "path": "dist/virtual.js",
      "limit": "7 KB"
    },
    {
      "path": "dist/headless.js",
      "limit": "3 KB"
    },
    {
      "path": "dist/styles.css",
      "limit": "2 KB"
    }
  ]
}
